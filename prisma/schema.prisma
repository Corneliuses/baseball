// Youth Baseball Team Manager — data model.
//
// The shape here is load-bearing and is explained in
// .agents/app-brainstorm/youth-baseball-team-manager/stack-decisions.md
// (Decisions 13, 15 and 16). Two rules survive from those decisions:
//
//   1. People are global; participation is team-scoped.
//      `User` and `Player` are persons and carry NO team-specific column.
//      `Membership` and `RosterEntry` are where a person meets a team.
//
//   2. The batting order and positions chart are STANDING per team, not
//      per game. They live as nullable columns on `RosterEntry`, which is
//      why there is no Lineup / LineupSlot / PositionAssignment model. A
//      batting slot is a property of a roster spot, so a player cannot be
//      in a lineup they are not rostered on — the invalid state is
//      unrepresentable rather than merely rejected.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Per-team role. Never inherited across teams — someone added to a new team
/// always arrives as PARENT and is elevated on that team individually.
enum Role {
  OWNER
  COACH
  PARENT
}

enum EventType {
  GAME
  PRACTICE
}

/// The nine standard defensive positions. C is Catcher; CENTER_FIELD is CF.
enum Position {
  PITCHER
  CATCHER
  FIRST_BASE
  SECOND_BASE
  THIRD_BASE
  SHORTSTOP
  LEFT_FIELD
  CENTER_FIELD
  RIGHT_FIELD
}

// ---------------------------------------------------------------------------
// People — global, no team column, persist across seasons
// ---------------------------------------------------------------------------

/// A person with an account, or who will have one. Rows are created when the
/// owner enters an email, BEFORE that person ever signs in — which is what
/// lets a not-yet-verified parent hold a Membership. Auth.js attaches the
/// session on first magic-link click.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  guardianOf        GuardianPlayer[]
  sentMessages      Message[]
  pushSubscriptions PushSubscription[]
  recordedRsvps     Rsvp[]             @relation("RsvpRecordedBy")
  reminderReceipts  ReminderReceipt[]
}

/// A child. Holds only what is true of the child regardless of team.
/// Do NOT add jerseyNumber, preferredPosition, or battingOrder here — a player
/// may be on two active teams at once and those differ per team.
model Player {
  id          String    @id @default(cuid())
  name        String
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())

  rosterEntries RosterEntry[]
  guardians     GuardianPlayer[]
  rsvps         Rsvp[]
}

/// Family link. Deliberately NOT team-scoped: it is what makes adding a
/// returning player able to pull their guardians onto a new team without
/// reconstructing anything.
model GuardianPlayer {
  userId   String
  playerId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([userId, playerId])
  @@index([playerId])
}

// ---------------------------------------------------------------------------
// Teams and participation
// ---------------------------------------------------------------------------

model Team {
  id     String  @id @default(cuid())
  name   String
  season String?

  /// Team setting: every kid bats and fields.
  allPlay Boolean @default(true)

  /// Non-null means archived. Archived teams render fully but reject every
  /// mutation, for every role including OWNER — enforced in requireTeamAccess.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  /// Capability credential for the ICS feed URL (/api/calendar/[token]) —
  /// calendar apps poll with no cookies, so the URL carries its own auth.
  /// Same posture as Invitation.token: unguessable (32 random bytes,
  /// base64url, generateCalendarToken), revocable by overwriting. Non-null:
  /// the migration backfills existing rows so the feed read path never has
  /// to write — archived teams reject every write, and their feeds must
  /// keep serving.
  calendarToken String @unique

  memberships   Membership[]
  rosterEntries RosterEntry[]
  events        Event[]
  invitations   Invitation[]
  messages      Message[]
}

/// A person's access to one team, with the role they hold on it.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  role      Role     @default(PARENT)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

/// A player's spot on one team — and, via the two nullable chart columns, that
/// team's standing lineup and positions chart.
///
/// `battingOrder` and `position` are null for a benched player, which is how
/// allPlay = false is expressed. The chart is simply this table ordered by
/// battingOrder. There is no separate lineup model and no per-game copy: see
/// Decision 16 before adding one.
model RosterEntry {
  id           String @id @default(cuid())
  playerId     String
  teamId       String
  jerseyNumber Int?

  /// Standing batting order slot. Null = not in the batting order.
  battingOrder Int?

  /// Standing defensive position. Null = bench / dugout.
  position Position?

  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([playerId, teamId])
  @@unique([teamId, battingOrder])
  @@unique([teamId, position])
  @@unique([teamId, jerseyNumber])
  @@index([teamId])
}

/// Gates account creation — there is no self-serve signup. Scoped to the team
/// the person is being invited onto.
model Invitation {
  id         String    @id @default(cuid())
  teamId     String
  email      String
  role       Role      @default(PARENT)
  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
}

// ---------------------------------------------------------------------------
// Schedule
// ---------------------------------------------------------------------------

model Event {
  id       String    @id @default(cuid())
  teamId   String
  type     EventType
  startsAt DateTime
  location String?
  opponent String?
  notes    String?

  team             Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rsvps            Rsvp[]
  reminderReceipts ReminderReceipt[]

  @@index([teamId, startsAt])
}

/// One player's attendance for one event. Practices have RSVPs too; only games
/// are read by the next-game readiness check.
model Rsvp {
  id           String   @id @default(cuid())
  eventId      String
  playerId     String
  attending    Boolean
  /// Set only when a staff member (COACH+) recorded this response on the
  /// family's behalf (#54); null means the family recorded it themselves.
  /// Every write sets or clears it, so last-write-wins carries provenance —
  /// the parent stays the owner of the state. SetNull so deleting a staff
  /// account can never take a family's RSVP with it.
  recordedById String?
  updatedAt    DateTime @updatedAt

  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player     Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  recordedBy User?  @relation("RsvpRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([eventId, playerId])
  @@index([playerId])
  @@index([recordedById])
}

// ---------------------------------------------------------------------------
// Messaging and push
// ---------------------------------------------------------------------------

model Message {
  id       String   @id @default(cuid())
  teamId   String
  senderId String
  subject  String
  body     String
  sentAt   DateTime @default(now())

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@index([teamId, sentAt])
  @@index([senderId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One day-of reminder actually dispatched for one (event, guardian) pair —
/// the duplicate-protection ledger behind /api/cron/reminders (#47).
///
/// The `@@unique([eventId, userId])` constraint IS the dedup mechanism: a row
/// is claimed BEFORE the email is sent and deleted again if that send fails,
/// so a cron re-run skips what already went out and retries only what did
/// not. Two overlapping invocations therefore race at the database rather
/// than in application logic — the same "make the invalid state
/// unrepresentable" posture the chart columns take in Decision 16.
///
/// Cascade on both sides: this is operational bookkeeping, not history anyone
/// reads back, so a deleted event or account takes its receipts with it.
model ReminderReceipt {
  id      String   @id @default(cuid())
  eventId String
  userId  String
  sentAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) adapter models
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
