# Copy to .env and fill in. Never commit .env — .gitignore covers it.
#
# Prisma reads DATABASE_URL via prisma.config.ts. The AUTH_* names are read by
# src/lib/auth-client.ts and src/lib/pending-login-cookie.ts. AUTH_SECRET and
# AUTH_URL keep the names Auth.js used; AUTH_ISSUER, AUTH_CLIENT_ID and
# AUTH_CLIENT_SECRET are new with the auth service.

# --- Database -----------------------------------------------------------------
# Neon Postgres (Decision 3). Provisioned through the Vercel Marketplace, which
# injects this automatically in deployed environments — you only set it locally.
# Use a Neon *dev branch* for local work so you never point at the real season.
# Prisma 7 talks to this through @prisma/adapter-pg; see src/lib/db.ts.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Auth ---------------------------------------------------------------------
# Sign-in goes through the auth service (Kernel ID) over OpenID Connect; the
# app keeps its own database sessions. Required in every environment.
#
# Keys the sealed pending-login cookie that carries a login's PKCE verifier,
# state and nonce between /api/auth/login (or an invitation accept) and
# /api/auth/callback. Sessions are database rows, so rotating this signs
# nobody out; it only fails logins in flight at that moment. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# This deployment's public origin. The auth service client derives its redirect
# URI (AUTH_URL + /api/auth/callback) and post-logout URI (AUTH_URL + /) from it,
# and the service matches both exactly, so set it in every environment to the
# origin registered there: https://coach.corneliuses.com in Production,
# https://preview.baseball.corneliuses.com in Preview. There is no fallback to
# the per-deploy *.vercel.app URL, which is never registered.
#
# Production and Preview are separate Vercel values and move separately: the
# move to coach.corneliuses.com (#96) changed Production only. It is also the
# base of every emailed link and the calendar subscribe URL (absolute-url.ts),
# so it is the single switch for the app's host. The old production host,
# baseball.corneliuses.com, stays on the Vercel project as a 308 redirect to
# the new one, because invitation links already in inboxes and every
# subscribed calendar still carry it.
AUTH_URL="http://localhost:3000"

# The auth service (auth.corneliuses.com), read by src/lib/auth-client.ts at
# first use, never at build. The client id and secret come from the service's
# `pnpm admin clients:create` output; the secret is shown once there.
AUTH_ISSUER="https://auth.corneliuses.com"
AUTH_CLIENT_ID=""
AUTH_CLIENT_SECRET=""

# --- Email --------------------------------------------------------------------
# Resend (Decision 7), for the app's own mail: invitations, added-to-team
# notices, event announcements, reminders and coach broadcasts. Sign-in codes
# are the auth service's mail, not this app's.
RESEND_API_KEY=""

# This MUST be a domain verified in Resend — unverified domains fail silently
# into spam, which is the failure mode most likely to make parents think the
# app is broken.
EMAIL_FROM="Team Manager <noreply@your-verified-domain.com>"

# --- Web Push (post-MVP, Decision 8) ------------------------------------------
# Web Push (#47). Generate a key pair with:
#   pnpm exec web-push generate-vapid-keys
# The public key is not a secret — it is handed to every browser that
# subscribes — but it is still read at request time and passed to the opt-in
# card as a prop rather than being a NEXT_PUBLIC_ variable, so the build stays
# free of environment requirements (same posture as RESEND_API_KEY in
# src/lib/email.ts). With these unset the /profile card simply does not render
# and the reminder cron sends email only; push never gates the email.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Must be a mailto: or https: URL — push services use it to contact you about
# a misbehaving sender.
VAPID_SUBJECT="mailto:you@your-domain.com"

# The single global owner of this instance. Not a database column: the app is
# multi-team but single-owner, so there is nothing to store.
#
# This address is the one exception to the invitation gate. It can always sign
# in through the auth service, including before any User row exists, which is how the very first account
# comes into being — and it is the only account permitted to create teams.
# Creating a team grants it Membership(OWNER) on that team.
#
# Leave it unset and nobody holds the exception: invited users still sign in
# normally, but no team can be created. That is deliberate — a misconfigured
# deployment should fail closed.
OWNER_EMAIL="coach@example.com"

# Vercel Cron -> /api/cron/reminders (day-of reminder emails, #47).
# Vercel sends this as an `Authorization: Bearer <value>` header on every cron
# invocation; the route compares and 401s otherwise. Unset means the route
# refuses to run at all — it fails closed, so an unconfigured deploy has no
# reminder endpoint rather than an open one. Generate like AUTH_SECRET:
#   openssl rand -base64 32
CRON_SECRET=""
