# Copy to .env and fill in. Never commit .env — .gitignore covers it.
#
# Variable names below were taken from the installed packages, not from memory:
#   AUTH_SECRET / AUTH_URL / AUTH_TRUST_HOST -> @auth/core/lib/utils/env.js
#   Prisma reads DATABASE_URL via prisma.config.ts

# --- Database -----------------------------------------------------------------
# Neon Postgres (Decision 3). Provisioned through the Vercel Marketplace, which
# injects this automatically in deployed environments — you only set it locally.
# Use a Neon *dev branch* for local work so you never point at the real season.
# Prisma 7 talks to this through @prisma/adapter-pg; see src/lib/db.ts.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# --- Auth ---------------------------------------------------------------------
# Auth.js v5. Generate with:  pnpm dlx auth secret
# Rotating this invalidates every active session, which means ~25 parents get
# signed out at once. Rotate deliberately, not casually.
AUTH_SECRET=""

# Only needed locally. On Vercel the VERCEL env var makes Auth.js trust the host
# automatically, so leave both of these unset in deployed environments.
AUTH_URL="http://localhost:3000"

# --- Email --------------------------------------------------------------------
# Resend (Decision 7). One key serves both magic links and the app's own mail
# (invitations, added-to-team notices, coach broadcasts); pass it explicitly to
# the Auth.js Resend provider as `apiKey` rather than also setting
# AUTH_RESEND_KEY, so there is a single source of truth for the key.
RESEND_API_KEY=""

# The Auth.js Resend provider defaults `from` to an authjs.dev address, which
# will not deliver. This MUST be a domain verified in Resend — unverified
# domains fail silently into spam, which is the failure mode most likely to make
# parents think the app is broken.
EMAIL_FROM="Team Manager <noreply@your-verified-domain.com>"

# --- Web Push (post-MVP, Decision 8) ------------------------------------------
# Not needed until push ships. Generate with:  pnpm dlx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@your-domain.com"
